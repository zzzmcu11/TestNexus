# AI API Configuration
# For DeepSeek models:
DEEPSEEK_API_KEY=sk-AAAAAAAAAAAAAAAAAAAAAAAA

# For Qwen models (Alibaba Cloud DashScope):
QWEN_API_KEY=sk-AAAAAAAAAAAAAAAAAAAAAAAA

# For SiliconFlow models (硅基流动):
SILICONFLOW_API_KEY=sk-sk-AAAAAAAAAAAAAAAAAAAAAAAA

# Model Configuration
MODEL_NAME=deepseek-reasoner
BASE_URL=https://api.deepseek.com
TEMPERATURE=0.1

# Qwen specific configuration
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# SiliconFlow specific configuration
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL_NAME=THUDM/GLM-Z1-9B-0414

# Application Configuration
DEBUG=True
PORT=18150

# API Usage Notes:
# 1. For DeepSeek models: Use DEEPSEEK_API_KEY and BASE_URL
# 2. For Qwen models: Use QWEN_API_KEY and QWEN_BASE_URL
# 3. For SiliconFlow models: Use SILICONFLOW_API_KEY, SILICONFLOW_BASE_URL and SILICONFLOW_MODEL_NAME
# 4. If you only use one model type, set AI_API_KEY to that API key
